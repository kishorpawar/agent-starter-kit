{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(.agents/hooks/check-files.sh *)",
      "Bash(.agents/hooks/check-changed.sh)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/on-edit.sh",
            "timeout": 60,
            "statusMessage": "format + lint"
          }
        ]
      }
    ]
  }
}
